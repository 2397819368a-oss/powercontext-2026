+def test_cursor_secret_creation_retries_short_writes(tmp_path, monkeypatch, generated_secret) -> None:
+    database_path = tmp_path / "powercontext.db"
+    config = SQLiteConfig(url=f"sqlite+aiosqlite:///{database_path}")
+    real_write = os.write
+    writes = 0
+
+    def short_write(descriptor: int, data: bytes | memoryview) -> int:
+        nonlocal writes
+        writes += 1
+        if writes == 1:
+            return real_write(descriptor, data[:7])
+        return real_write(descriptor, data)
+
+    monkeypatch.setattr("powercontext.server.cursor_secret.os.write", short_write)
+
+    secret = resolve_cursor_secret(config, None)
+
+    key_path = tmp_path / ".powercontext.db.cursor-key"
+    assert writes >= 2
+    assert secret == generated_secret
+    assert key_path.read_bytes() == generated_secret
+
+
+def test_cursor_secret_creation_removes_partial_file_after_write_failure(
+    tmp_path, monkeypatch, generated_secret
+) -> None:
+    database_path = tmp_path / "powercontext.db"
+    config = SQLiteConfig(url=f"sqlite+aiosqlite:///{database_path}")
+    key_path = tmp_path / ".powercontext.db.cursor-key"
+    real_write = os.write
+    writes = 0
+
+    def failing_write(descriptor: int, data: bytes | memoryview) -> int:
+        nonlocal writes
+        writes += 1
+        if writes == 1:
+            return real_write(descriptor, data[:7])
+        raise OSError("simulated disk write failure")
+
+    monkeypatch.setattr("powercontext.server.cursor_secret.os.write", failing_write)
+
+    with pytest.raises(OSError, match="simulated disk write failure"):
+        resolve_cursor_secret(config, None)
+
+    assert not key_path.exists()
+
+    monkeypatch.setattr("powercontext.server.cursor_secret.os.write", real_write)
+    assert resolve_cursor_secret(config, None) == generated_secret
+    assert key_path.read_bytes() == generated_secret
