# PowerContext Server 运行配置（本机验证用）
# 说明：Dify 跑在容器里，访问宿主机不能用 127.0.0.1，所以这里绑 0.0.0.0，
# 同时开启 Bearer 认证，避免同网段其他人直接读写记忆。
POWERCONTEXT_SERVER_HTTP_HOST=0.0.0.0
POWERCONTEXT_SERVER_HTTP_PORT=8000
POWERCONTEXT_SERVER_ACCESS_MODE=enforced
POWERCONTEXT_SERVER_AUTH_TOKEN=<换成你自己的随机串，例如 openssl rand -hex 24>
POWERCONTEXT_SERVER_ALLOW_UNAUTHENTICATED_NON_LOOPBACK=false
# Dashboard 用来肉眼核对记忆是否真的落库（截图证据）
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=true

# ---- 向量通道：让 Memory 检索从「全文」升级到「全文+向量混合 RRF」 ----
# 不配 embedding 时 PowerContext 只有全文通道：Jieba 分词后要求候选至少命中 2 个查询词，
# 于是「我是不是有东西落这儿了」这种说法翻不出「蓝色油纸伞」那条记忆。
# 这里指向本机 multilingual-e5-small 的 ONNX 导出（mean pooling + L2 归一化由该服务完成）。
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BASE_URL=http://127.0.0.1:8091/v1
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_MODEL=openai:multilingual-e5-small
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_PROFILE_ID=e5-small-local
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_DIMENSION=384
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_NORMALIZATION=unit
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_SEND_DIMENSIONS=false
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_TIMEOUT_SECONDS=60
POWERCONTEXT_SERVER_INFERENCE_EMBEDDING_BATCH_SIZE=8
